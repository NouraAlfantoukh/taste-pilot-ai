# At least one of ANTHROPIC_API_KEY or GEMINI_API_KEY is needed for the chat to answer (Claude is tried first).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=
# Thinking depth for Claude (default: low). Use "off" to omit the parameter for models that reject it.
ANTHROPIC_EFFORT=
GEMINI_MODEL=
# Optional. When both Supabase values are set the app asks users to sign in (or continue as a guest) and
# remembers their durable preferences; when empty the app works exactly as before and saves nothing.
SUPABASE_URL=
# The anon / publishable key ONLY. Never put a service_role or secret key here: the app refuses to use one.
SUPABASE_KEY=
# Only for the opt-in real-service tests (`pytest -m integration`, see docs/TESTING_GUIDE.md). Use a DEVELOPMENT
# project and dedicated, confirmed email/password test users; never real customers. The tests write and delete
# ONLY the signed-in test user's own `user_preferences` row.
# A and B: tests/integration/test_supabase_rls.py and test_supabase_memory.py. B and C: test_real_conversation_memory.py.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
SUPABASE_TEST_USER_C_EMAIL=
SUPABASE_TEST_USER_C_PASSWORD=
