ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=
# Thinking depth for Claude (default: low). Use "off" to omit the parameter for models that reject it.
ANTHROPIC_EFFORT=
GEMINI_MODEL=
# Optional. When both Supabase values are set the app asks users to sign in (or continue as a guest) and
# remembers their durable preferences; when empty the app works exactly as before and saves nothing.
SUPABASE_URL=
# The anon / publishable key ONLY. Never put a service_role or secret key here: the app refuses to use one.
SUPABASE_KEY=
# Only for the opt-in real-project tests in tests/integration/test_supabase_*.py. Use a DEVELOPMENT project
# and two dedicated, confirmed email/password test users; never real customers.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
